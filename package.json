{
  "id": "deki-lovyangfx",
  "displayName": "LovyanGFX Integration",
  "minEngine": "0.13.0",
  "buildDefine": "DEKI_PACKAGE_LOVYANGFX",
  "requires": [
    "deki-i2c"
  ],
  "features": [
    {
      "id": "display",
      "displayName": "Display Panel",
      "buildDefine": "DEKI_FEATURE_LGFX_DISPLAY_PANEL",
      "defaultEnabled": true,
      "componentTypes": [
        "LGFXDisplayPanel"
      ]
    },
    {
      "id": "touch",
      "displayName": "Touch Panel",
      "buildDefine": "DEKI_FEATURE_LGFX_TOUCH_PANEL",
      "defaultEnabled": true,
      "componentTypes": [
        "LGFXTouchPanel"
      ]
    }
  ],
  "dependencies": {
    "default": [
      {
        "name": "LovyanGFX",
        "version": "1.2.19",
        "git": "https://github.com/lovyan03/LovyanGFX.git"
      }
    ],
    "espidf": [
      {
        "name": "LovyanGFX",
        "version": "1.2.19",
        "git": "https://github.com/lovyan03/LovyanGFX.git"
      }
    ]
  }
}
